  "hardware": {
    "$description": "Emissive surfaces on the pedal itself: small displays and indicator LEDs. Mode-less: a lit display on a dark stage is always dark, so every value aliases a primitive directly and none has a per-mode value. Not emitted to CSS and not overridable by skins. Built to dist/c/*_hardware.h, dist/json/*.hardware.json, and the C++ and Swift token files.",
    "display": {
      "$type": "color",
      "$description": "A colour display (RGB565 TFT or OLED). The reduced palette: six roles, index order fixed (0..5) for palette-indexed drivers.",
      "background": {
        "$value": "{primitive.color.black}",
        "$description": "Pixels off. True black: an OLED draws no current, and a TFT backlight bleeds least."
      },
      "text": {
        "$value": "{primitive.color.grey.100}",
        "$description": "Values, names, menu items."
      },
      "secondary": {
        "$value": "{primitive.color.grey.400}",
        "$description": "Legends, units, the unselected item."
      },
      "accent": {
        "$value": "{primitive.color.blue.300}",
        "$description": "Your hand: the selected item, the value being turned, in tune."
      },
      "limit": {
        "$value": "{primitive.color.vermillion.400}",
        "$description": "The limit only: CLIP, gain reduction, errors. Always with a word or shape as well."
      },
      "rule": {
        "$value": "{primitive.color.grey.500}",
        "$description": "Tracks and dividers. Decorative: never the only cue."
      }
    },
    "led": {
      "$type": "color",
      "$description": "Indicator lamps. For an RGB LED (WS2812, SK6812) the build also emits gamma-decoded PWM duties; for a single-colour LED the value is the design intent for choosing the part (amber for the hand, red for the limit).",
