      "$description": "Brand-specific ink parameters. DTCG has no brush type, so each is a plain number; the group is marked as one composite for our build.",
      "$extensions": {
        "cc.squatch.ink": {
          "composite": "brush"
        }
      },
      "brush": {
        "$type": "number",
        "entry": {
          "$value": 0.12,
          "$description": "Press-in length, 0..1 of the stroke."
        },
        "exit": {
          "$value": 0.35,
          "$description": "Lift-off length, 0..1."
        },
        "belly": {
          "$value": 0.15,
          "$description": "Mid-stroke swell."
        },
        "dry": {
          "$value": 0.5,
          "$description": "0 wet .. 1 very dry: how far dry streaks reach."
        },
        "streaks": {
          "$value": 7,
          "$description": "Dry-brush cuts per stroke (5-9 in the ink look)."
        },
        "jitter": {
          "$value": 0.07,
          "$description": "Per-sample width jitter; seeded, never re-randomised per frame."
        },
        "bleed": {
          "$value": 0.15,
