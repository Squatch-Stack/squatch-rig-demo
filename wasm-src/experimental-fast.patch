+#pragma once
+// Experimental fast path: a planar kernel for depthwise-separable WaveNets.
+//
+// Experimental: a Squatch Stack research architecture, not an upstream NAM
+// designation. It is A2's layer stack with each dilated convolution made depthwise
+// (groups_input == channels), so the per-layer mixing is done only by the
+// existing layer 1x1. It is expressible in stock NAM configs and loads in stock
+// Core through the generic WaveNet; this path is what makes it fast.
+//
+// Layout is planar (one contiguous plane per channel) and every inner loop runs
+// across frames, the arrangement that suits a per-channel FIR best. Operation
+// order follows the generic path (taps summed from zero, oldest first; then the
+// conv bias; then + mixin; activation; layer 1x1 then its bias; residual add),
+// so results differ from it only where Eigen's own summation order differs
+// (the 1x1), i.e. at float rounding.
+
+#if defined(NAM_ENABLE_A2_FAST)
+
+  #include <memory>
+
+  #include "json.hpp"
+
+  #include "../model_config.h"
+
+namespace nam
+{
+namespace wavenet
+{
+namespace experimental_fast
+{
+
+/// True when `config` is a single-stack depthwise LeakyReLU WaveNet this path
+/// implements exactly (see experimental_fast.cpp for the full list of conditions).
+bool is_experimental_shape(const nlohmann::json& config, int* channels);
+
+std::unique_ptr<ModelConfig> create_experimental_fast_config(const nlohmann::json& config, double sampleRate);
+
+} // namespace experimental_fast
+} // namespace wavenet
+} // namespace nam
+
+#endif
