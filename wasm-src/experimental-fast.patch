+#if defined(NAM_ENABLE_A2_FAST)
+// The config of a hand-optimized model for the shapes that have one (A2, experimental), or nullptr.
+std::unique_ptr<nam::ModelConfig> create_fast_config(const nlohmann::json& config, double sampleRate)
+{
