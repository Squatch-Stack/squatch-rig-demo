diff --git a/tools/test/test_experimental_fast.cpp b/tools/test/test_experimental_fast.cpp
new file mode 100644
index 0000000..53a7414
--- /dev/null
+++ b/tools/test/test_experimental_fast.cpp
@@ -0,0 +1,206 @@
+// Tests for the experimental fast path: for a config that matches the experimental shape (A2's layer
+// stack with depthwise dilated convolutions), the fast path must produce the
+// generic WaveNet's output on the same input and weights, keep its state across
+// calls larger than the maximum buffer size, and not allocate while processing.
+//
+// Built only when NAM_ENABLE_A2_FAST is defined at compile time.
+
+#if defined(NAM_ENABLE_A2_FAST)
+
+  #include <algorithm>
+  #include <cassert>
+  #include <cmath>
+  #include <memory>
+  #include <string>
+  #include <vector>
+
+  #include "json.hpp"
+
+  #include "NAM/dsp.h"
+  #include "NAM/wavenet/experimental_fast.h"
+  #include "NAM/wavenet/model.h"
+
+  #include "allocation_tracking.h"
+
+namespace test_experimental_fast
+{
+namespace
+{
+
+constexpr double kSampleRate = 48000.0;
+const std::vector<int> kKernelSizes = {6, 6, 15, 3};
+const std::vector<int> kDilations = {1, 7, 2, 30};
+constexpr int kHeadKernelSize = 16;
+
+nlohmann::json build_experimental_config(const int channels)
+{
+  const nlohmann::json leaky = {{"type", "LeakyReLU"}, {"negative_slope", 0.01}};
+  const nlohmann::json film_inactive = {{"active", false}, {"shift", true}, {"groups", 1}};
+  nlohmann::json layer = {{"input_size", 1},
+                          {"condition_size", 1},
+                          {"channels", channels},
+                          {"bottleneck", channels},
+                          {"kernel_sizes", kKernelSizes},
+                          {"dilations", kDilations},
+                          {"activation", std::vector<nlohmann::json>(kDilations.size(), leaky)},
+                          {"gating_mode", std::vector<std::string>(kDilations.size(), "none")},
+                          {"secondary_activation", std::vector<nlohmann::json>(kDilations.size(), nullptr)},
+                          {"head", {{"out_channels", 1}, {"kernel_size", kHeadKernelSize}, {"bias", true}}},
+                          {"head1x1", {{"active", false}, {"out_channels", 1}, {"groups", 1}}},
+                          {"layer1x1", {{"active", true}, {"groups", 1}}},
+                          {"groups_input", channels},
+                          {"groups_input_mixin", 1}};
+  for (const char* film : {"conv_pre_film", "conv_post_film", "input_mixin_pre_film", "input_mixin_post_film",
+                           "activation_pre_film", "activation_post_film", "layer1x1_post_film", "head1x1_post_film"})
+  {
+    layer[film] = film_inactive;
+  }
+  return {{"layers", nlohmann::json::array({layer})}, {"head_scale", 0.02}};
+}
+
+std::vector<float> make_weights(const int channels)
+{
+  int count = channels; // rechannel
+  for (const int k : kKernelSizes)
+  {
+    count += channels * k + channels; // depthwise conv + bias
+    count += channels; // input mixin
+    count += channels * channels + channels; // layer 1x1 + bias
+  }
+  count += channels * kHeadKernelSize + 1 + 1; // head + bias, head scale
+  std::vector<float> weights(count);
+  for (int i = 0; i < count; i++)
+  {
+    weights[i] = 0.3f * std::sin(0.61f * static_cast<float>(i) + static_cast<float>(channels));
+  }
+  return weights;
+}
+
+std::unique_ptr<nam::DSP> make_fast(const int channels)
+{
+  return nam::wavenet::experimental_fast::create_experimental_fast_config(build_experimental_config(channels), kSampleRate)
+    ->create(make_weights(channels), kSampleRate);
+}
+
+std::unique_ptr<nam::DSP> make_generic(const int channels)
+{
+  return nam::wavenet::parse_config_json(build_experimental_config(channels), kSampleRate)
+    .create(make_weights(channels), kSampleRate);
+}
+
+std::vector<NAM_SAMPLE> make_input(const int num_frames)
+{
+  std::vector<NAM_SAMPLE> input(num_frames);
+  for (int i = 0; i < num_frames; i++)
+  {
+    input[i] = static_cast<NAM_SAMPLE>(0.5 * std::sin(0.013 * i) * std::sin(0.29 * i));
+  }
+  return input;
+}
+
+// Process all of `input` in calls of `block` frames. No call may allocate.
+std::vector<NAM_SAMPLE> render(nam::DSP& dsp, std::vector<NAM_SAMPLE> input, const int block)
+{
+  std::vector<NAM_SAMPLE> output(input.size());
+  for (size_t start = 0; start < input.size(); start += block)
+  {
+    NAM_SAMPLE* in = input.data() + start;
+    NAM_SAMPLE* out = output.data() + start;
+    const int n = static_cast<int>(std::min<size_t>(block, input.size() - start));
+    allocation_tracking::run_allocation_test_no_allocations(
+      nullptr, [&]() { dsp.process(&in, &out, n); }, nullptr, "experimental fast path process()");
+  }
+  return output;
+}
+
+bool rejects(void (*change)(nlohmann::json& layer))
+{
+  nlohmann::json config = build_experimental_config(8);
+  change(config["layers"][0]);
+  return !nam::wavenet::experimental_fast::is_experimental_shape(config, nullptr);
+}
+
+} // namespace
+
+void test_detector_accepts_supported_channels()
+{
+  for (const int channels : {4, 8, 12, 16})
+  {
+    int detected = 0;
+    assert(nam::wavenet::experimental_fast::is_experimental_shape(build_experimental_config(channels), &detected));
+    assert(detected == channels);
+  }
+}
+
+void test_detector_rejects_other_shapes()
+{
+  assert(rejects([](nlohmann::json& la) { la["groups_input"] = 1; })); // dense conv: the A2 shape
+  assert(rejects([](nlohmann::json& la) {
+    la["channels"] = 6;
+    la["bottleneck"] = 6;
+    la["groups_input"] = 6;
+  }));
+  assert(rejects([](nlohmann::json& la) { la["gating_mode"][0] = "gated"; }));
+  assert(rejects([](nlohmann::json& la) { la["head1x1"]["active"] = true; }));
+  assert(rejects([](nlohmann::json& la) { la["conv_pre_film"]["active"] = true; }));
+  assert(rejects([](nlohmann::json& la) { la["kernel_sizes"].push_back(3); }));
+  nlohmann::json conditioned = build_experimental_config(8);
+  conditioned["condition_dsp"] = {{"architecture", "Linear"}};
+  assert(!nam::wavenet::experimental_fast::is_experimental_shape(conditioned, nullptr));
+}
+
+void test_matches_generic()
+{
+  const auto input = make_input(4096);
+  for (const int channels : {4, 8, 12, 16})
+  {
+    for (const int block : {1, 7, 32, 61, 64})
+    {
+      auto fast = make_fast(channels);
+      auto generic = make_generic(channels);
+      fast->Reset(kSampleRate, block);
+      generic->Reset(kSampleRate, block);
+      const auto expected = render(*generic, input, block);
+      const auto actual = render(*fast, input, block);
+      for (size_t i = 0; i < input.size(); i++)
+      {
+        assert(std::fabs(actual[i] - expected[i]) < 1.0e-5);
+      }
+    }
+  }
+}
+
+// wavenet::create_config gives an experimental-shaped config the fast path, not the generic WaveNet.
+void test_create_config_uses_fast_path()
+{
+  auto dsp = nam::wavenet::create_config(build_experimental_config(8), kSampleRate)->create(make_weights(8), kSampleRate);
+  assert(dynamic_cast<nam::wavenet::WaveNet*>(dsp.get()) == nullptr);
+}
+
+void test_prewarm_matches_generic()
+{
+  assert(make_fast(8)->GetPrewarmSamples() == make_generic(8)->GetPrewarmSamples());
+}
+
+// A call with more frames than the maximum buffer size matches calls of at most that size.
+void test_oversized_call_matches_consecutive_calls()
+{
+  const int max_buffer = 32;
+  const int call_size = 100; // Not a multiple of max_buffer, so each call's last chunk is short
+  const auto input = make_input(20 * call_size);
+  auto oversized = make_fast(8);
+  auto consecutive = make_fast(8);
+  oversized->Reset(kSampleRate, max_buffer);
+  consecutive->Reset(kSampleRate, max_buffer);
+  std::vector<NAM_SAMPLE> expected;
+  for (size_t start = 0; start < input.size(); start += call_size)
+  {
+    const auto call = render(*consecutive, {input.begin() + start, input.begin() + start + call_size}, max_buffer);
+    expected.insert(expected.end(), call.begin(), call.end());
+  }
+  assert(render(*oversized, input, call_size) == expected);
+}
+
+} // namespace test_experimental_fast
+
+#endif // NAM_ENABLE_A2_FAST
